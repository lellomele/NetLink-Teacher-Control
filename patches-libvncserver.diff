diff --git a/libvncclient/write_timeout.h b/libvncclient/write_timeout.h
new file mode 100644
index 0000000..3d66e41
--- /dev/null
+++ b/libvncclient/write_timeout.h
@@ -0,0 +1,67 @@
+/* NetLink hardening, GPL-2.0-or-later.
+ * Copyright (C) 2025-26 prof. Ing. Raffaele Mele
+ * Shared absolute, monotonic deadline for writes on LibVNCClient's
+ * non-blocking sockets. Partial progress never renews the deadline.
+ */
+#ifndef RFB_CLIENT_WRITE_TIMEOUT_H
+#define RFB_CLIENT_WRITE_TIMEOUT_H
+
+#include <stdint.h>
+#include <limits.h>
+#include <errno.h>
+#ifdef WIN32
+#include <windows.h>
+#else
+#include <time.h>
+#endif
+
+static inline uint64_t rfbWriteNowMs(void)
+{
+#ifdef WIN32
+    return (uint64_t)GetTickCount64();
+#else
+    struct timespec value;
+    if (clock_gettime(CLOCK_MONOTONIC, &value) != 0) return UINT64_MAX;
+    return (uint64_t)value.tv_sec * 1000 + (uint64_t)value.tv_nsec / 1000000;
+#endif
+}
+
+static inline uint64_t rfbWriteDeadlineMs(const rfbClient* client)
+{
+    const uint64_t now = rfbWriteNowMs();
+    int seconds = client->readTimeout;
+    if (seconds <= 0) seconds = 30;
+    if (seconds > 60) seconds = 60;
+    return now == UINT64_MAX ? 0 : now + (uint64_t)seconds * 1000;
+}
+
+/* Returns 1 for readiness, 0 for deadline, -1 for a permanent socket error. */
+static inline int rfbWaitForWriteSocket(rfbSocket socket, int wantRead, uint64_t deadline)
+{
+#ifndef WIN32
+    if (socket < 0 || socket >= FD_SETSIZE) return -1;
+#endif
+    for (;;) {
+        fd_set descriptors;
+        struct timeval remaining;
+        const uint64_t now = rfbWriteNowMs();
+        uint64_t milliseconds;
+        int result;
+        if (now >= deadline) return 0;
+        milliseconds = deadline - now;
+        remaining.tv_sec = (long)(milliseconds / 1000);
+        remaining.tv_usec = (long)((milliseconds % 1000) * 1000);
+        FD_ZERO(&descriptors);
+        FD_SET(socket, &descriptors);
+        result = select((int)(socket + 1), wantRead ? &descriptors : NULL,
+                        wantRead ? NULL : &descriptors, NULL, &remaining);
+        if (result >= 0) return result > 0 ? 1 : 0;
+#ifdef WIN32
+        if (WSAGetLastError() != WSAEINTR) return -1;
+#else
+        if (errno != EINTR) return -1;
+#endif
+    }
+}
+
+#endif
