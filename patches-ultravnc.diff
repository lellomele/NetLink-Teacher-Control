-char * NameFromPath(const char *path)
-{
-	int x;
-	int l = (int)strlen(path);
-	char *temp = NULL;
-	
-	// Find the file part of a filename
-	for (x=l-1; x>0; x--)
-	{
-		if (path[x] == '\\')
-		{
-			temp = _strdup(&(path[x+1]));
-			break;
-		}
-	}
-
-	// If we didn't fine a \ then just return a copy of the original
-	if (temp == NULL)
-		temp = _strdup(path);
-
-	return temp;
-}
