+#include "VNCHooks.h"
+
+// Loaded into unrelated processes, including the desktop compositor: no CRT,
+// C++ runtime, heap, TLS, constructors, registry or synchronous cross-process IO.
+#ifndef VNCHOOKS_MAPPING_NAME
+#define VNCHOOKS_MAPPING_NAME "Local\\NetLinkVncHooks-v2"
+#endif
+#ifndef VNCHOOKS_MUTEX_NAME
+#define VNCHOOKS_MUTEX_NAME "Local\\NetLinkVncHooks-owner-v2"
+#endif
+
+struct SharedVariables {
+	volatile LONG threadId, processId;
+	volatile LONG updateMessage, copyMessage, mouseMessage, ddiHook;
+	volatile LONG postFailures, reentrantHints, hookFailures;
+};
+static HINSTANCE g_instance = NULL;
+static volatile LONG g_attached = 0, g_initialization = 0, g_operation = 0, g_callback = 0;
+static volatile LONG g_keyboardActive = FALSE, g_mouseActive = FALSE;
+static SharedVariables *g_shared = NULL;
+static HANDLE g_mapping = NULL;
+static HHOOK volatile g_callHook = NULL, g_messageHook = NULL, g_dialogHook = NULL;
+static HHOOK volatile g_keyboardHook = NULL, g_mouseHook = NULL;
+static DWORD g_ownerThread = 0;
+static UINT g_deferredMessage = 0;
+static PVOID volatile g_cursor = NULL;
+
+static LONG ReadLong(volatile LONG *p) { return InterlockedCompareExchange(p, 0, 0); }
+static HHOOK ReadHook(HHOOK volatile *p) {
+	return (HHOOK)InterlockedCompareExchangePointer((PVOID volatile *)p, NULL, NULL);
+}
+static void WriteHook(HHOOK volatile *p, HHOOK hook) { InterlockedExchangePointer((PVOID volatile *)p, hook); }
+static void Failure(volatile LONG *counter, const char *message) {
+	// A full receiver queue must not cause an unbounded diagnostic flood.
+	if (InterlockedIncrement(counter) == 1) OutputDebugStringA(message);
+}
+
+static BOOL EnsureInitialized() {
+	if (!ReadLong(&g_attached)) return FALSE;
+	const LONG old = InterlockedCompareExchange(&g_initialization, 1, 0);
+	if (old != 0) return old == 2;
+	// No waits if another callback initializes. Hints may be dropped because
+	// software polling remains authoritative. This runs outside loader lock.
+	HANDLE mapping = CreateFileMappingA(INVALID_HANDLE_VALUE, NULL, PAGE_READWRITE,
+		0, sizeof(SharedVariables), VNCHOOKS_MAPPING_NAME);
+	SharedVariables *shared = mapping ? (SharedVariables *)MapViewOfFile(
+		mapping, FILE_MAP_ALL_ACCESS, 0, 0, sizeof(SharedVariables)) : NULL;
+	const UINT deferred = RegisterWindowMessageA("NetLinkVncHooks.Deferred.UpdateMessage.v2");
+	if (!mapping || !shared || !deferred) {
+		if (shared) UnmapViewOfFile(shared);
+		if (mapping) CloseHandle(mapping);
+		InterlockedExchange(&g_initialization, -1);
+		OutputDebugStringA("NetLink vnchooks: initialization failed; polling fallback remains active.\n");
+		return FALSE;
+	}
+	g_mapping = mapping; g_shared = shared; g_deferredMessage = deferred;
+	InterlockedExchange(&g_initialization, 2);
+	return TRUE;
+}
+
+extern "C" BOOL WINAPI DllMain(HINSTANCE instance, DWORD reason, LPVOID reserved) {
+	if (reason == DLL_PROCESS_ATTACH) {
+		g_instance = instance;
+		InterlockedExchange(&g_attached, TRUE);
+		DisableThreadLibraryCalls(instance);
+	} else if (reason == DLL_PROCESS_DETACH) {
+		InterlockedExchange(&g_attached, FALSE);
+		// Owner unhooks explicitly before unloading. Never call User32,
+		// enumerate windows, touch registry or wait under the loader lock.
+		if (!reserved) {
+			if (g_shared) UnmapViewOfFile(g_shared);
+			if (g_mapping) CloseHandle(g_mapping);
+		}
+	}
+	// Optional update hints must never prevent the host process from loading.
+	return TRUE;
+}
+
+static BOOL BeginOperation() {
+	if (!EnsureInitialized()) return FALSE;
+	if (InterlockedCompareExchange(&g_operation, 1, 0)) { SetLastError(ERROR_BUSY); return FALSE; }
+	return TRUE;
+}
+static HANDLE LockOwner() {
+	HANDLE mutex = CreateMutexA(NULL, FALSE, VNCHOOKS_MUTEX_NAME);
+	if (mutex) {
+		const DWORD result = WaitForSingleObject(mutex, 0);
+		if (result == WAIT_OBJECT_0 || result == WAIT_ABANDONED) return mutex;
+		CloseHandle(mutex);
+	}
+	SetLastError(ERROR_BUSY); return NULL;
+}
+static void UnlockOwner(HANDLE mutex) { ReleaseMutex(mutex); CloseHandle(mutex); }
+static BOOL OwnerAlive(DWORD id) {
+	if (!id) return FALSE;
+	HANDLE process = OpenProcess(SYNCHRONIZE, FALSE, id);
+	if (!process) return GetLastError() != ERROR_INVALID_PARAMETER; // access denied: fail closed
+	const BOOL alive = WaitForSingleObject(process, 0) != WAIT_OBJECT_0;
+	CloseHandle(process); return alive;
+}
+static BOOL RemoveHook(HHOOK volatile *slot) {
+	const HHOOK hook = ReadHook(slot);
+	if (!hook) return TRUE;
+	if (!UnhookWindowsHookEx(hook)) {
+		Failure(&g_shared->hookFailures, "NetLink vnchooks: unhook failed; handle retained for retry.\n");
+		return FALSE;
+	}
+	WriteHook(slot, NULL); return TRUE;
+}
+static BOOL RemoveAllHooks() {
+	// Do not short-circuit: a failure must not skip removal of other hooks.
+	// Always restore real input immediately, even if the OS refuses unhook.
+	InterlockedExchange(&g_keyboardActive, FALSE);
+	InterlockedExchange(&g_mouseActive, FALSE);
+	BOOL ok = RemoveHook(&g_keyboardHook);
+	if (!RemoveHook(&g_mouseHook)) ok = FALSE;
+	if (!RemoveHook(&g_callHook)) ok = FALSE;
+	if (!RemoveHook(&g_messageHook)) ok = FALSE;
+	if (!RemoveHook(&g_dialogHook)) ok = FALSE;
+	return ok;
+}
+static LRESULT CALLBACK CallWndProc(int, WPARAM, LPARAM);
+static LRESULT CALLBACK GetMessageProc(int, WPARAM, LPARAM);
+static LRESULT CALLBACK DialogMessageProc(int, WPARAM, LPARAM);
+static LRESULT CALLBACK KeyboardProc(int, WPARAM, LPARAM);
+static LRESULT CALLBACK MouseProc(int, WPARAM, LPARAM);
+
+DllExport DWORD HooksType() { return 0; } // unreliable hints, not a replacement for polling
+
+DllExport BOOL SetHooks(DWORD thread, UINT update, UINT copy, UINT mouse, BOOL ddi) {
+	if (!thread || !update || !mouse || !BeginOperation()) return FALSE;
+	HANDLE mutex = LockOwner();
+	if (!mutex) { InterlockedExchange(&g_operation, 0); return FALSE; }
+	BOOL ok = FALSE;
+	const DWORD process = GetCurrentProcessId(), owner = (DWORD)ReadLong(&g_shared->processId);
+	if (g_ownerThread || (owner && OwnerAlive(owner))) SetLastError(ERROR_ALREADY_EXISTS);
+	else {
+		// Recover a dead owner even when foreign processes retain the mapping.
+		// Publish a receiver only after its complete configuration is ready.
+		InterlockedExchange(&g_shared->threadId, 0);
+		InterlockedExchange(&g_shared->processId, (LONG)process);
+		g_ownerThread = thread;
+		InterlockedExchange(&g_shared->updateMessage, (LONG)update);
+		InterlockedExchange(&g_shared->copyMessage, (LONG)copy);
+		InterlockedExchange(&g_shared->mouseMessage, (LONG)mouse);
+		InterlockedExchange(&g_shared->ddiHook, ddi);
+		WriteHook(&g_messageHook, SetWindowsHookExA(WH_GETMESSAGE, GetMessageProc, g_instance, 0));
+		if (!ddi) {
+			WriteHook(&g_callHook, SetWindowsHookExA(WH_CALLWNDPROC, CallWndProc, g_instance, 0));
+			WriteHook(&g_dialogHook, SetWindowsHookExA(WH_SYSMSGFILTER, DialogMessageProc, g_instance, 0));
+		}
+		ok = ReadHook(&g_messageHook) && (ddi || (ReadHook(&g_callHook) && ReadHook(&g_dialogHook)));
+		if (ok) InterlockedExchange(&g_shared->threadId, (LONG)thread);
+		else {
+			const DWORD error = GetLastError();
+			Failure(&g_shared->hookFailures, "NetLink vnchooks: installation failed; polling fallback remains active.\n");
+			if (RemoveAllHooks()) { g_ownerThread = 0; InterlockedExchange(&g_shared->processId, 0); }
+			SetLastError(error);
+		}
+	}
+	UnlockOwner(mutex); InterlockedExchange(&g_operation, 0); return ok;
+}
+
+DllExport BOOL UnSetHooks(DWORD thread) {
+	if (!BeginOperation()) return FALSE;
+	HANDLE mutex = LockOwner();
+	BOOL ok = FALSE;
+	if (mutex) {
+		// Verify ownership before removing input hooks or touching shared data.
+		if (!thread || thread != g_ownerThread ||
+			(DWORD)ReadLong(&g_shared->processId) != GetCurrentProcessId()) SetLastError(ERROR_ACCESS_DENIED);
+		else {
+			InterlockedExchange(&g_shared->threadId, 0);
+			ok = RemoveAllHooks();
+			if (ok) { g_ownerThread = 0; InterlockedExchange(&g_shared->processId, 0); }
+		}
+		UnlockOwner(mutex);
+	}
+	InterlockedExchange(&g_operation, 0); return ok;
+}
+
+static BOOL SetFilter(BOOL active, int type, HOOKPROC callback, HHOOK volatile *slot, volatile LONG *enabled) {
+	if (!BeginOperation()) return FALSE;
+	BOOL ok = TRUE;
+	if (active && !ReadHook(slot)) {
+		const HHOOK hook = SetWindowsHookExA(type, callback, g_instance, 0);
+		WriteHook(slot, hook); ok = hook != NULL;
+		if (!ok) Failure(&g_shared->hookFailures, "NetLink vnchooks: input filter installation failed.\n");
+	}
+	if (active) InterlockedExchange(enabled, ok && ReadHook(slot));
+	else {
+		InterlockedExchange(enabled, FALSE);
+		ok = RemoveHook(slot);
+	}
+	InterlockedExchange(&g_operation, 0); return ok;
+}
+DllExport BOOL SetKeyboardFilterHook(BOOL active) { return SetFilter(active, WH_KEYBOARD_LL, KeyboardProc, &g_keyboardHook, &g_keyboardActive); }
+DllExport BOOL SetMouseFilterHook(BOOL active) { return SetFilter(active, WH_MOUSE_LL, MouseProc, &g_mouseHook, &g_mouseActive); }
+
+DllExport BOOL GetHookDiagnostics(VNCHOOKS_DIAGNOSTICS *d) {
+	if (!d || d->size != sizeof(VNCHOOKS_DIAGNOSTICS) || !EnsureInitialized()) return FALSE;
+	d->version = 1;
+	d->ownerProcessId = (DWORD)ReadLong(&g_shared->processId);
+	d->ownerThreadId = (DWORD)ReadLong(&g_shared->threadId);
+	d->postFailures = (DWORD)ReadLong(&g_shared->postFailures);
+	d->reentrantHints = (DWORD)ReadLong(&g_shared->reentrantHints);
+	d->hookFailures = (DWORD)ReadLong(&g_shared->hookFailures);
+	return TRUE;
+}
+static void PostHint(UINT message, WPARAM w, LPARAM l) {
+	const DWORD thread = (DWORD)ReadLong(&g_shared->threadId);
+	if (thread && message && !PostThreadMessageA(thread, message, w, l))
+		Failure(&g_shared->postFailures, "NetLink vnchooks: receiver queue unavailable/full; hint dropped.\n");
+}
+static SHORT Coordinate(LONGLONG value) {
+	if (value < -32768) return -32768;
+	if (value > 32767) return 32767;
+	return (SHORT)value;
+}
+static void SendRect(HWND window, const RECT *rect, BOOL deferred) {
+	if (rect->left >= rect->right || rect->top >= rect->bottom) return;
+	const WPARAM first = MAKELONG(Coordinate(rect->left), Coordinate(rect->top));
+	const LPARAM last = MAKELONG(Coordinate(rect->right), Coordinate(rect->bottom));
+	if (deferred) {
+		if (!PostMessageA(window, g_deferredMessage, first, last))
+			Failure(&g_shared->postFailures, "NetLink vnchooks: deferred queue unavailable/full; hint dropped.\n");
+	} else PostHint((UINT)ReadLong(&g_shared->updateMessage), first, last);
+}
+static void WindowRect(HWND window, BOOL deferred) {
+	RECT rect;
+	if (IsWindowVisible(window) && GetWindowRect(window, &rect)) SendRect(window, &rect, deferred);
+}
+static void HandleMessage(UINT message, HWND window, WPARAM w, LPARAM l) {
+	if (message == g_deferredMessage) { PostHint((UINT)ReadLong(&g_shared->updateMessage), w, l); return; }
+	if (message == WM_MOUSEMOVE || message == WM_NCMOUSEMOVE) {
+		const HCURSOR cursor = GetCursor();
+		if (InterlockedExchangePointer(&g_cursor, cursor) != cursor) PostHint((UINT)ReadLong(&g_shared->mouseMessage), (WPARAM)cursor, 0);
+		return;
+	}
+	if (ReadLong(&g_shared->ddiHook)) return;
+	switch (message) {
+	case WM_PAINT: {
+		// One bounding rectangle replaces unbounded region enumeration,
+		// throwing new[], GDI handles and per-rectangle Sleep(0) in foreign GUI
+		// threads. Polling still computes the actual changed screen pixels.
+		RECT rect; POINT origin = {0, 0};
+		if (GetUpdateRect(window, &rect, FALSE) && ClientToScreen(window, &origin)) {
+			rect.left = Coordinate((LONGLONG)rect.left + origin.x);
+			rect.top = Coordinate((LONGLONG)rect.top + origin.y);
+			rect.right = Coordinate((LONGLONG)rect.right + origin.x);
+			rect.bottom = Coordinate((LONGLONG)rect.bottom + origin.y);
+			SendRect(window, &rect, TRUE);
+		}
+		break;
+	}
+	case WM_WINDOWPOSCHANGING: WindowRect(window, FALSE); break;
+	case WM_NCPAINT: case WM_NCACTIVATE:
+		InterlockedExchangePointer(&g_cursor, NULL); WindowRect(window, TRUE); break;
+	case WM_CHAR: case WM_KEYUP: case WM_LBUTTONUP: case WM_MBUTTONUP: case WM_RBUTTONUP:
+	case WM_SYSCOLORCHANGE: case WM_PALETTECHANGED: case WM_SETTEXT: case WM_ENABLE:
+	case BM_SETCHECK: case BM_SETSTATE: case EM_SETSEL: case WM_WINDOWPOSCHANGED:
+	case WM_MOUSEWHEEL: case 485: // popup hint without foreign window properties
+		WindowRect(window, TRUE); break;
+	case WM_HSCROLL: case WM_VSCROLL:
+		if (LOWORD(w) == SB_THUMBTRACK || LOWORD(w) == SB_ENDSCROLL) WindowRect(window, TRUE);
+		break;
+	default: break;
+	}
+}
+static BOOL BeginCallback() {
+	if (!EnsureInitialized() || !ReadLong(&g_shared->threadId)) return FALSE;
+	if (InterlockedCompareExchange(&g_callback, 1, 0)) {
+		InterlockedIncrement(&g_shared->reentrantHints); return FALSE;
+	}
+	return TRUE;
+}
+static LRESULT CALLBACK CallWndProc(int code, WPARAM w, LPARAM l) {
+	if (code == HC_ACTION && l && BeginCallback()) {
+		const CWPSTRUCT *m = (const CWPSTRUCT *)l;
+		HandleMessage(m->message, m->hwnd, m->wParam, m->lParam);
+		InterlockedExchange(&g_callback, 0);
+	}
+	return CallNextHookEx(NULL, code, w, l);
+}
+static LRESULT CALLBACK GetMessageProc(int code, WPARAM w, LPARAM l) {
+	if (code == HC_ACTION && (w & PM_REMOVE) && l && BeginCallback()) {
+		const MSG *m = (const MSG *)l;
+		HandleMessage(m->message, m->hwnd, m->wParam, m->lParam);
+		InterlockedExchange(&g_callback, 0);
+	}
+	return CallNextHookEx(NULL, code, w, l);
+}
+static LRESULT CALLBACK DialogMessageProc(int code, WPARAM w, LPARAM l) {
+	if (code >= 0 && l && BeginCallback()) {
+		const MSG *m = (const MSG *)l;
+		HandleMessage(m->message, m->hwnd, m->wParam, m->lParam);
+		InterlockedExchange(&g_callback, 0);
+	}
+	return CallNextHookEx(NULL, code, w, l);
+}
+static LRESULT CALLBACK KeyboardProc(int code, WPARAM w, LPARAM l) {
+	if (code == HC_ACTION && l && ReadLong(&g_attached) && ReadLong(&g_keyboardActive)) {
+		const KBDLLHOOKSTRUCT *event = (const KBDLLHOOKSTRUCT *)l;
+		if (!(event->flags & LLKHF_INJECTED)) return TRUE;
+	}
+	return CallNextHookEx(NULL, code, w, l);
+}
+static LRESULT CALLBACK MouseProc(int code, WPARAM w, LPARAM l) {
+	if (code == HC_ACTION && l && ReadLong(&g_attached) && ReadLong(&g_mouseActive)) {
+		const MSLLHOOKSTRUCT *event = (const MSLLHOOKSTRUCT *)l;
+		if ((event->dwExtraInfo & 0xFF515700) == 0xFF515700 || !(event->flags & LLMHF_INJECTED)) return TRUE;
+	}
+	return CallNextHookEx(NULL, code, w, l);
+}
