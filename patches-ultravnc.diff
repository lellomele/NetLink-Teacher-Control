@@ -0,0 +1,35 @@
+// Copyright (c) 2025-26 prof. Ing. Raffaele Mele
+// GNU General Public License v2 or (at your option) any later version.
+#ifndef NETLINK_VNC_REGION_QUEUE_H
+#define NETLINK_VNC_REGION_QUEUE_H
+
+#include "omnithread.h"
+#include "rfbRegion.h"
+
+// Window-message producer and capture-thread consumer share only this queue.
+// The mutex is constructed before either thread starts and destroyed after
+// vncDesktop stops/joins them. No polling flags, event operations or I/O under
+// this lock; no other desktop/server lock is acquired by these methods.
+class VncRegionQueue
+{
+public:
+	void add(const rfb::Rect& rect)
+	{
+		if (rect.is_empty()) return;
+		const rfb::Region2D addition(rect);
+		omni_mutex_lock guard(m_mutex, 0);
+		m_pending.assign_union(addition);
+	}
+
+	void drain(rfb::Region2D& destination)
+	{
+		omni_mutex_lock guard(m_mutex, 0);
+		destination.assign_union(m_pending);
+		m_pending.clear();
+	}
+
+private:
+	omni_mutex m_mutex;
+	rfb::Region2D m_pending;
+};
+#endif
