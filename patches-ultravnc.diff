-#endif
-	  hModuleKey = GetModuleKey(HKEY_CURRENT_USER, proc_name, true, true);
-	  if (hModuleKey == NULL)
-		  return FALSE;
-#ifdef _MSC_VER 
-		_RPT0(_CRT_WARN, "vncHooks : writing user prefs\n");
-#endif
-
-		WriteProfileInt(
-			"use_GetUpdateRect",
-			prf_use_GetUpdateRect
-			);
-
-		WriteProfileInt(
-			"use_Timer",
-			prf_use_Timer
-			);
-
-		WriteProfileInt(
-			"use_KeyPress",
-			prf_use_KeyPress
-			);
-
-		WriteProfileInt(
-			"use_LButtonUp",
-			prf_use_LButtonUp
-			);
-
-		WriteProfileInt(
-			"use_MButtonUp",
-			prf_use_MButtonUp
-			);
-
-		WriteProfileInt(
-			"use_RButtonUp",
-			prf_use_RButtonUp
-			);
-
-		WriteProfileInt(
-			"use_Deferral",
-			prf_use_Deferral
-			);
