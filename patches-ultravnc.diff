-		free(sModulePrefs);
-		sModulePrefs = NULL;
-	}
-
-	// Close the registry key for this module
-  if (hModuleKey != NULL) {
-		RegCloseKey(hModuleKey);
-    hModuleKey = NULL;
-  }
-
-	return TRUE;
